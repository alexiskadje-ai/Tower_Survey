# URL de base de l'API backend.
# En dev, laisse vide : Vite proxy /api vers VITE_API_PROXY_TARGET (voir vite.config.js).
# En prod (build), pointe directement vers l'API déployée (ex: Railway).
VITE_API_BASE_URL=/api

# Cible du proxy de dev uniquement (non utilisé en prod build)
VITE_API_PROXY_TARGET=http://localhost:4000
