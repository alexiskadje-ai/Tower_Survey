# Base de données PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/tower_survey_db

# Serveur
PORT=4000
NODE_ENV=development

# Sécurité
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d

# Stockage médias (V1 = disque local)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# URL publique de base utilisée pour construire les hyperliens dans les exports Excel.
# IMPORTANT : doit être une URL absolue (avec http:// ou https://) et NON un chemin
# relatif. Les fichiers .xlsx générés peuvent être ouverts ailleurs que sur le
# serveur (email, partage, etc.) — si l'URL est relative, les liens photo ne
# seront plus cliquables. Exemples :
#   dev  : http://localhost:4000
#   prod : https://api.teleinfra-cm.com
PUBLIC_BASE_URL=http://localhost:4000

# Email Configuration (Custom mail server)
EMAIL_HOST=mail.teleinfra-cm.com
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_USER=no-reply@teleinfra-cm.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=no-reply@teleinfra-cm.com
SUPPORT_EMAIL=support@teleinfra-cm.com